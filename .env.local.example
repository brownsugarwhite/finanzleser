# Beispiel-Konfiguration für lokale Entwicklung.
# Echten Inhalt nach .env.local kopieren — .env.local ist gitignored.

# WordPress-GraphQL-Endpoint (Local by Flywheel)
WORDPRESS_API_URL=http://finanzleser.local/graphql

# LEO-Backend des Kunden (Python/FastAPI-RAG-Service auf Heroku).
# /api/chat proxyt darauf — Modell (Claude Haiku 4.5) und System-Prompt liegen im Backend.
LEO_BACKEND_URL=https://leo-finanzleser-ea7e1549925c.herokuapp.com

# Schaukasten: Route /schaukasten mit allen Elementen des Fadens (Abnahme-Werkzeug).
# In der Entwicklung immer an. In einem Produktions-Build — also auch im Deploy-Preview —
# nur mit diesem Schalter; ohne ihn gibt es die Route nicht (404).
# NEXT_PUBLIC_SCHAUKASTEN=1
