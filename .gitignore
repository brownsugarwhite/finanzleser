# Next.js
.next/
# Zweiter Ausgabeordner für Prüfläufe neben einem laufenden Dev-Server (NEXT_DIST_DIR).
.next-*/
out/

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Dependencies
node_modules/

# Env files
.env*.local
.env.staging
.env.production

# Build
build/
dist/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Vercel / Netlify
.vercel
.netlify

# Lokale MCP-Server-Registrierung (maschinenspezifische Pfade)
.mcp.json

# Office-Sperrdateien (~$Datei.xlsx), entstehen beim Oeffnen in Excel/Word
~$*

# Binaerdokumente in docs/: Angebote, Bugreports, Content-Inventare.
# Gehoeren nicht in ein Frontend-Repo — liegen im Projektordner bzw. beim Kunden.
docs/*.xlsx
docs/*.docx

# Roh-Exporte aus der Search Console (ZIP). Jederzeit neu ziehbar, und die
# Auswertung landet ohnehin als CSV/Markdown im Repo — nicht der Rohexport.
docs/seo_export_*/

# Hinweis: assets/ und scripts/ wurden am 10.08.2026 in das Schwester-Repo
# ../finanzleser-assets ausgelagert (156 MB, kein Anwendungsbezug). Falls sie
# versehentlich wieder auftauchen, gehoeren sie dorthin — nicht hierher.
assets/
scripts/
# 🚨 … aber NICHT die unter public/: dort liegen echte Projekt-Assets (59 Bilder,
# 2 Skripte), die längst verfolgt sind. Ohne diese Ausnahme greift die Regel oben auch
# auf `public/assets/` und `public/scripts/` — NEUE Dateien dort verschwinden dann
# lautlos aus `git status`, der Build bleibt lokal grün und auf Netlify fehlt das Bild.
# Genau das am 16.09.2026 beim Flugfenster passiert.
!public/assets/
!public/scripts/

# Faden: abgeleitete/generierte Dateien (reproduzierbar per tools/faden-text.mjs,
# tools/faden-export.mjs und python3 docs/prototype/build.py; zusammen ~20 MB)
docs/inhalte/text/
docs/prototype/daten/
docs/prototype/src/02b-daten.html
docs/prototype/leo-faden.html
docs/https___www.finanzleser.de_-Coverage-Drilldown-*/

# Design-Übergabe (Claude Design, 09.09.2026): README, github.md und die .dc.html sind
# versioniert — die Asset-Kopien nicht. Alle 2,4 MB liegen bereits in public/ (geprüft),
# und support.js ist die Laufzeit des Prototyp-Werkzeugs, kein Projektcode.
docs/design_handoff_finanzleser_faden/public/
docs/design_handoff_finanzleser_faden/support.js
docs/design_handoff_finanzleser_faden/.DS_Store

# Design-Übergabe „Finanzleser Heute" (17.09.2026): dieselbe Regel wie oben. README und
# die drei .dc.html sind die Übergabe; der public/-Ordner daneben ist eine Kopie unserer
# eigenen Icons (28 Dateien, bis auf Zeilenenden identisch geprüft) und support.js ist
# die Laufzeit des Prototyp-Werkzeugs.
# AUSNAHME wochenbrief-himmel.png: das Bild liegt NIRGENDWO sonst — /assets/flug/himmel.webp
# im Projekt ist ein anderer, quadratischer Ausschnitt (1046x1046 gegen 1456x880).
# Die Freigabe gilt dem ORDNER, sonst greift die unverankerte Regel `assets/` von oben.
docs/design_handoff_finanzleser_heute/public/icons/
!docs/design_handoff_finanzleser_heute/public/assets/
docs/design_handoff_finanzleser_heute/public/assets/leo.svg
docs/design_handoff_finanzleser_heute/support.js
docs/design_handoff_finanzleser_heute/.DS_Store

# Design-Übergabe „Solitär" (17.09.2026): README und die .dc.html sind versioniert,
# support.js ist wie bei den anderen nur die Laufzeit des Prototyp-Werkzeugs.
docs/design_handoff_finanzleser_solitaer/support.js
docs/design_handoff_finanzleser_solitaer/.DS_Store
Finanzleser Chat-Design Phase 2.zip

# Die ZIP-Exporte aus Claude Design und was beim Auspacken im Projektstamm landet.
# 🚨 Am 17.09.2026 aufgeräumt: die fünf ZIPs und die drei Ordner
# `design_handoff_finanzleser_kursblatt{, 2, 3}` liegen jetzt im Schwester-Repo unter
# ../finanzleser-assets/design-uebergaben/ (mit README). Die maßgeblichen Fassungen
# stehen versioniert in docs/design_handoff_finanzleser_{faden,kursblatt,heute}/.
# Die Regeln bleiben stehen, damit der nächste Export nicht wieder im Stamm auftaucht.
/design_handoff_finanzleser_kursblatt/
/design_handoff_finanzleser_kursblatt [0-9]/
/Finanzleser Chat-Design*.zip
