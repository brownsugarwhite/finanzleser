  "leoFragen": [
    {
      "abschnitt": "heading-2",
      "abschnitt_titel": "Was schützt die Hausratversicherung und wer braucht sie?",
      "status": "freigegeben",
      "frage": "Ich wohne zur Miete. Brauche ich überhaupt eine Hausratversicherung?",
      "antwort": "Die Wohnung gehört dem Vermieter, alles darin gehört Ihnen — und genau das versichert die Hausrat. Rechnen Sie einmal zusammen, was Küche, Kleidung, Elektronik, Möbel und Fahrräder zusammen kosten würden, wenn Sie alles neu kaufen müssten. Bei 78 Prozent der Haushalte gibt es deshalb eine Police. Der Beitrag liegt je nach Ort und Fläche oft unter 60 Euro im Jahr.",
      "quellen": [
        "GDV, Einkommens- und Verbrauchsstichprobe 2023"
      ]
    },
    {
      "abschnitt": "heading-3",
      "abschnitt_titel": "Welche Schäden sind versichert und in welcher Höhe?",
      "status": "freigegeben",
      "frage": "Die Waschmaschine ist ausgelaufen und hat das Laminat ruiniert. Wer zahlt?",
      "antwort": "Das Laminat ist Ihr Eigentum, wenn Sie es selbst verlegt haben — dann zahlt die Hausrat als Leitungswasserschaden. Gehört der Boden zur Wohnung, ist es ein Mietsachschaden und Ihre Privathaftpflicht zuständig. Die Waschmaschine selbst ersetzt weder die eine noch die andere: Ein Gerätedefekt ist kein Versicherungsfall. Leitungswasser macht fast ein Viertel des gesamten Schadenaufwands in der Hausrat aus.",
      "quellen": [
        "GDV, Hausratversicherung: Schäden je Gefahr"
      ]
    },
    {
      "abschnitt": "heading-4",
      "abschnitt_titel": "Wie hoch sollte die Versicherungssumme sein?",
      "status": "freigegeben",
      "frage": "Ich habe 90 Quadratmeter. Reichen 58.500 Euro Versicherungssumme?",
      "antwort": "Das entspricht genau der verbreiteten Pauschale von 650 Euro je Quadratmeter, und für die meisten Haushalte passt sie. Prüfen Sie trotzdem: Wer eine hochwertige Einbauküche, teure Elektronik oder eine Sammlung besitzt, liegt schnell darüber. Vereinbaren Sie zusätzlich den Unterversicherungsverzicht — dann kürzt der Versicherer im Schaden nicht anteilig, falls die Summe doch zu niedrig war.",
      "quellen": [
        "GDV, VHB 2022 Quadratmetermodell",
        "Verbraucherzentrale, Hausratversicherung"
      ]
    },
    {
      "abschnitt": "heading-5",
      "abschnitt_titel": "Was kostet eine Hausratversicherung 2026?",
      "status": "freigegeben",
      "frage": "Mein Beitrag ist ohne Vorwarnung gestiegen. Darf der Versicherer das?",
      "antwort": "Ja, wenn der Vertrag eine Anpassungsklausel enthält — bei der Hausrat ist das die Regel, weil die Versicherungssumme an den Baupreisindex gekoppelt ist. Sie haben dann aber ein Sonderkündigungsrecht: einen Monat ab Zugang der Mitteilung, wenn die Erhöhung nicht mit mehr Leistung einhergeht. Der Schadenaufwand ist zwischen 2020 und 2024 von 1,14 auf 1,82 Milliarden Euro gestiegen; Beitragserhöhungen sind also nicht aus der Luft gegriffen.",
      "quellen": [
        "§ 40 VVG",
        "GDV, Statistiken zur deutschen Versicherungswirtschaft"
      ]
    },
    {
      "abschnitt": "heading-6",
      "abschnitt_titel": "Wichtige Zusatzbausteine für modernen Schutz",
      "status": "freigegeben",
      "frage": "Mein Fahrrad hat 3.000 Euro gekostet. Ist es mitversichert?",
      "antwort": "Im Keller oder in der Wohnung ja, im Rahmen der Versicherungssumme. Draußen — abgeschlossen am Laternenpfahl — nur mit dem Baustein Fahrraddiebstahl, und der ist meist auf ein bis zwei Prozent der Versicherungssumme gedeckelt. Bei 58.500 Euro Summe wären das 585 bis 1.170 Euro, für Ihr Rad also zu wenig. Prüfen Sie eine eigene Fahrradversicherung oder eine höhere Entschädigungsgrenze.",
      "quellen": [
        "GDV, VHB 2022 Quadratmetermodell"
      ]
    },
    {
      "abschnitt": "heading-6",
      "abschnitt_titel": "Wichtige Zusatzbausteine für modernen Schutz",
      "status": "freigegeben",
      "frage": "Ich wohne nicht am Fluss. Was bringt mir der Elementarbaustein?",
      "antwort": "Überschwemmung ist nur eine von sechs Elementargefahren. Starkregen kann jede Lage treffen — das Wasser läuft über den Bordstein, drückt durch Lichtschächte oder steigt aus der Kanalisation zurück. Dazu kommen Rückstau, Erdrutsch, Schneedruck und Erdbeben. Wie schnell das ins Geld geht, zeigt 2024: Die Elementarleistungen in der Hausrat stiegen von 100 auf 230 Millionen Euro.",
      "quellen": [
        "GDV, Hausratversicherung: Schäden je Gefahr"
      ]
    },
    {
      "abschnitt": "heading-7",
      "abschnitt_titel": "Smart-Home-Risiken und digitale Gefahren",
      "status": "freigegeben",
      "frage": "Eingebrochen wurde durch die gekippte Terrassentür. Zahlt die Versicherung?",
      "antwort": "Wahrscheinlich nicht in voller Höhe. Ein gekipptes Fenster gilt versicherungsrechtlich als offen — es liegt dann kein Einbruchdiebstahl vor, sondern einfacher Diebstahl, und der ist nicht versichert. Selbst wo Versicherer kulant sind, kürzen sie wegen grober Fahrlässigkeit. Tarife mit dem Zusatz Verzicht auf den Einwand der groben Fahrlässigkeit zahlen trotzdem, meist bis zu einer festen Grenze.",
      "quellen": [
        "§ 81 Abs. 2 VVG",
        "GDV, VHB 2022 Quadratmetermodell"
      ]
    },
    {
      "abschnitt": "heading-8",
      "abschnitt_titel": "Wann lohnt sich ein Wechsel der Hausratversicherung?",
      "status": "freigegeben",
      "frage": "Ich ziehe um. Was passiert mit meiner Hausratversicherung?",
      "antwort": "Sie zieht mit. Melden Sie den Umzug vorher; während der Umzugszeit sind beide Wohnungen für bis zu zwei Monate versichert. Danach müssen Sie die Wohnfläche anpassen, sonst erlischt der Unterversicherungsverzicht. Ändert sich der Beitrag wegen der neuen Lage um mehr als zehn Prozent, dürfen Sie kündigen — der Wohnort ist einer der stärksten Preisfaktoren überhaupt.",
      "quellen": [
        "§ 40 VVG",
        "GDV, VHB 2022 Quadratmetermodell"
      ]
    }
  ]
